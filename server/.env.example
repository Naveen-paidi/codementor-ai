# OpenRouter API (Required for AI Chatbot, Code Review, Programming Explanations)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
RAG_RERANKING_ENABLED=false

# Gemini API (Exclusively for Speech-to-Text and Text-to-Speech Voice Assistant)
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase Authentication & Database
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Initial Super Admin Accounts
SUPER_ADMIN_1_EMAIL=superadmin1@example.com
SUPER_ADMIN_1_PASSWORD=your_secure_password_here
SUPER_ADMIN_2_EMAIL=superadmin2@example.com
SUPER_ADMIN_2_PASSWORD=your_secure_password_here

PORT=5000